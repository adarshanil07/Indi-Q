{
  "expo": {
    "name": "Indi-Q",
    "slug": "indi-q",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "indiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.enjoygames.indiq",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.enjoygames.indiq",
      "adaptiveIcon": {
        "backgroundColor": "#FF9B00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7ef4c",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9280199166759720~7467789411",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Indi-Q uses this to show ads that are more relevant to you. You can still play the full game if you decline."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa1ffb50-1687-4afa-a2ce-c2e8e802319d"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/aa1ffb50-1687-4afa-a2ce-c2e8e802319d"
    }
  }
}
